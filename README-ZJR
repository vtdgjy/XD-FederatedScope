### 步骤 3: 创建自定义客户端类

创建 `federatedscope/core/workers/heterogeneous_client.py`：

```python
import torch
import logging
from federatedscope.core.workers import Client

logger = logging.getLogger(__name__)

class HeterogeneousClient(Client):
    """支持异构资源的客户端"""
    
    def __init__(self, *args, **kwargs):
        resource_info = kwargs.get('resource_info', None)
        super(HeterogeneousClient, self).__init__(*args, **kwargs)
        
        if resource_info:
            self.tier = resource_info.get('tier', 'unknown')
            self.gpu_memory_limit = resource_info.get('gpu_memory', 0)
            self._configure_by_tier()
            logger.info(f"Client {self.ID}: Tier={self.tier}, "
                       f"GPU Memory={self.gpu_memory_limit}MB, Device={self.device}")
    
    def _configure_by_tier(self):
        """根据层级配置训练参数"""
        if self.tier == 'tier1':
            # Tier-1: 完整训练
            if torch.cuda.is_available():
                self.device = 'cuda:0'
                
        elif self.tier == 'tier2':
            # Tier-2: 减半 batch size
            if hasattr(self, '_cfg'):
                self._cfg.defrost()
                self._cfg.dataloader.batch_size = max(
                    self._cfg.dataloader.batch_size // 2, 1)
                self._cfg.freeze()
            if torch.cuda.is_available():
                self.device = 'cuda:0'
                
        elif self.tier == 'tier3':
            # Tier-3: CPU + 1/4 batch size
            if hasattr(self, '_cfg'):
                self._cfg.defrost()
                self._cfg.dataloader.batch_size = max(
                    self._cfg.dataloader.batch_size // 4, 1)
                self._cfg.freeze()
            self.device = 'cpu'
```

### 步骤 4: 配置 YAML 文件

创建 `heterogeneous_fedavg.yaml`：

```yaml
use_gpu: True
device: 0
backend: torch
seed: 123

federate:
  mode: standalone
  client_num: 10
  sample_client_num: 10
  total_round_num: 50
  share_local_model: False
  method: FedAvg
  resource_info_file: 'client_heterogeneous_config.pkl'

data:
  root: data/
  type: CIFAR10@torchvision
  args: [{'download': True}]
  splits: [0.8, 0.1, 0.1]
  subsample: 0.2
  transform: [['ToTensor'], 
              ['Normalize', {'mean': [0.4914, 0.4822, 0.4465], 
                            'std': [0.2470, 0.2435, 0.2616]}]]
  splitter: 'lda'
  splitter_args: [{'alpha': 0.5}]

dataloader:
  batch_size: 64
  shuffle: True
  num_workers: 4

model:
  type: convnet2
  hidden: 2048
  out_channels: 10

train:
  local_update_steps: 5
  batch_or_epoch: epoch
  optimizer:
    type: SGD
    lr: 0.01
    momentum: 0.9
    weight_decay: 0.0005

eval:
  freq: 5
  metrics: ['acc', 'correct']
  best_res_update_round_wise_key: 'test_acc'

criterion:
  type: CrossEntropyLoss

trainer:
  type: cvtrainer
```

### 步骤 5: 创建运行脚本

创建 `run_heterogeneous_fl.py`：

```python
import sys
sys.path.append('.')

from federatedscope.core.auxiliaries.data_builder import get_data
from federatedscope.core.auxiliaries.utils import setup_seed
from federatedscope.core.auxiliaries.logging import update_logger
from federatedscope.core.configs.config import global_cfg
from federatedscope.core.auxiliaries.runner_builder import get_runner
from federatedscope.core.auxiliaries.worker_builder import get_server_cls
from federatedscope.core.workers.heterogeneous_client import HeterogeneousClient

if __name__ == '__main__':
    init_cfg = global_cfg.clone()
    init_cfg.merge_from_file('heterogeneous_fedavg.yaml')
    update_logger(init_cfg, clear_before_add=True)
    setup_seed(init_cfg.seed)
    
    print("正在加载数据...")
    data, modified_cfg = get_data(config=init_cfg.clone())
    init_cfg.merge_from_other_cfg(modified_cfg)
    init_cfg.freeze()
    
    print(f"总客户端数: {init_cfg.federate.client_num}")
    print(f"总训练轮数: {init_cfg.federate.total_round_num}")
    
    runner = get_runner(
        data=data,
        server_class=get_server_cls(init_cfg),
        client_class=HeterogeneousClient,
        config=init_cfg.clone(),
        client_configs=None
    )
    
    print("开始异构联邦学习训练...")
    runner.run()
```

### 步骤 6: 运行训练

```bash
python run_heterogeneous_fl.py
```

